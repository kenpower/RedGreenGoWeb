# Rendered by deploy.sh into /etc/nginx/sites-enabled/__APP_NAME__.conf, which
# compucore3's server { } block includes. The app calls
# https://<host>__URL_PATH__/coach
location __URL_PATH__/ {
    proxy_pass http://127.0.0.1:__PORT__/;   # trailing slash strips the __URL_PATH__ prefix
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 90s;
    client_max_body_size 256k;

    # Per-IP limit on top of the per-class daily allowance; the zone is defined
    # in conf.d/__APP_NAME__-ratelimit.conf
    limit_req zone=__APP_NAME__ burst=10 nodelay;
}
