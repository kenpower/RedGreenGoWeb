# Copy to .env.deploy (git-ignored) and fill in. Read by deploy.sh.

# SSH target
DEPLOY_HOST=compucore3.setu.ie
DEPLOY_USER=ken
# Private key to use; leave empty for ssh's default (~/.ssh/id_ed25519 etc.)
SSH_KEY=

# Optional: your sudo password on the server, so deploys don't ask for it.
# Sent to the server over ssh's stdin only, never on a command line or in a file there.
# Leave it out to be asked by sudo (or use ./deploy.sh --pwd to type it once, hidden).
#SUDO_PASSWORD=

# Claude API key for the coach; written to /etc/rgg-coach.env on the server
ANTHROPIC_API_KEY=

# Optional: defaults shown
APP_NAME=rgg-coach
INSTALL_DIR=/opt/rgg-coach
URL_PATH=/rgg-coach
PORT=8100
RATE_PER_MINUTE=20
